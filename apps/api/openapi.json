{
  "openapi": "3.0.3",
  "info": { "title": "MiniLedger API", "version": "1.0.0", "description": "Personal lending tracker API. Monetary values are decimal strings in INR. All loan data is scoped to the authenticated account." },
  "servers": [{ "url": "http://localhost:4000" }],
  "paths": {
    "/health": { "get": { "summary": "Health check", "responses": { "200": { "description": "API is running" } } } },
    "/api/v1/auth/request-otp": { "post": { "summary": "Request a development OTP", "requestBody": { "$ref": "#/components/requestBodies/Phone" }, "responses": { "202": { "description": "Challenge accepted; code is logged by the API in development" }, "400": { "$ref": "#/components/responses/BadRequest" }, "429": { "description": "Rate limit exceeded" } } } },
    "/api/v1/auth/verify-otp": { "post": { "summary": "Verify OTP and sign in", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["phoneNumber", "code"], "properties": { "phoneNumber": { "type": "string", "example": "+919876543210" }, "code": { "type": "string", "pattern": "^\\d{6}$" } } } } } }, "responses": { "200": { "description": "JWT and user identity" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "description": "Invalid or expired code" } } } },
    "/api/v1/auth/logout": { "post": { "summary": "End local session", "security": [{ "bearerAuth": [] }], "responses": { "204": { "description": "Signed out" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/v1/summary": { "get": { "summary": "Get financial overview", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Financial totals and loan counts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Summary" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/v1/loans": { "get": { "summary": "List the signed-in user's loans", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Loan records" } } }, "post": { "summary": "Create a loan", "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Loan" }, "responses": { "201": { "description": "Created loan" }, "400": { "$ref": "#/components/responses/BadRequest" } } } },
    "/api/v1/loans/{id}": { "parameters": [{ "$ref": "#/components/parameters/LoanId" }], "get": { "summary": "Get a loan and repayment history", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Loan details" }, "404": { "$ref": "#/components/responses/NotFound" } } }, "patch": { "summary": "Update loan details", "security": [{ "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/Loan" }, "responses": { "200": { "description": "Updated loan" }, "409": { "description": "Original amount is below repayments already recorded" } } }, "delete": { "summary": "Delete a loan without repayment history", "security": [{ "bearerAuth": [] }], "responses": { "204": { "description": "Deleted" }, "409": { "description": "Loan has repayment history" } } } },
    "/api/v1/loans/{id}/repayments": { "parameters": [{ "$ref": "#/components/parameters/LoanId" }], "get": { "summary": "List a loan's repayments", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Repayments" } } }, "post": { "summary": "Record a partial or final repayment", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["amount", "repaymentDate"], "properties": { "amount": { "type": "string", "example": "1250.00" }, "repaymentDate": { "type": "string", "format": "date" }, "note": { "type": "string" } } } } } }, "responses": { "201": { "description": "Repayment recorded" }, "409": { "description": "Repayment exceeds remaining balance" }, "404": { "$ref": "#/components/responses/NotFound" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": { "LoanId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } },
    "requestBodies": {
      "Phone": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["phoneNumber"], "properties": { "phoneNumber": { "type": "string", "example": "+919876543210" } } } } } },
      "Loan": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["friendName", "amount", "loanDate", "dueDate"], "properties": { "friendName": { "type": "string" }, "friendPhone": { "type": "string", "nullable": true }, "amount": { "type": "string", "example": "5000.00" }, "loanDate": { "type": "string", "format": "date" }, "dueDate": { "type": "string", "format": "date" }, "notes": { "type": "string", "nullable": true } } } } } }
    },
    "schemas": { "Summary": { "type": "object", "properties": { "currency": { "type": "string", "example": "INR" }, "totalLent": { "type": "string", "example": "15000.00" }, "totalRepaid": { "type": "string", "example": "7500.00" }, "outstanding": { "type": "string", "example": "7500.00" }, "overdueAmount": { "type": "string", "example": "2500.00" }, "activeLoans": { "type": "integer" }, "overdueLoans": { "type": "integer" }, "fullyRepaidLoans": { "type": "integer" } } } },
    "responses": { "BadRequest": { "description": "Request validation failed" }, "Unauthorized": { "description": "Authentication is required" }, "NotFound": { "description": "Owned loan was not found" } }
  }
}
