# Local MySQL connection. Replace these values before using outside development.
MYSQL_DATABASE=miniledger
MYSQL_USER=miniledger
MYSQL_PASSWORD=miniledger_dev
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_PORT=3306
DATABASE_URL=mysql://miniledger:miniledger_dev@localhost:3306/miniledger

# Backend settings for the future API
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
OTP_TTL_MINUTES=5
